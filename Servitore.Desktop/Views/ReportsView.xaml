<UserControl x:Class="Servitore.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
 
     <Grid Margin="24">
         <Grid.RowDefinitions>
             <RowDefinition Height="Auto" />
             <RowDefinition Height="Auto" />
             <RowDefinition Height="*" />
         </Grid.RowDefinitions>
 
         <StackPanel Grid.Row="0" Margin="0,0,0,16">
             <TextBlock Text="Reports" FontSize="26" FontWeight="SemiBold" />
             <TextBlock Text="Generate and export business reports" Opacity="0.55" FontSize="13" />
         </StackPanel>
 
         <!-- Filter Panel -->
         <Border Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}" 
                 CornerRadius="6" Padding="16" Margin="0,0,0,20">
             <StackPanel>
                 <TextBlock Text="Service Entry Report Filters" FontWeight="SemiBold" FontSize="14.5" Margin="0,0,0,12" />
                 <Grid>
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="Auto" />
                     </Grid.ColumnDefinitions>
                     
                     <DatePicker Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Start Date"
                                 SelectedDate="{Binding StartDate}"
                                 Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                 Margin="0,0,12,0" />
                                 
                     <DatePicker Grid.Column="1"
                                 materialDesign:HintAssist.Hint="End Date"
                                 SelectedDate="{Binding EndDate}"
                                 Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                 Margin="0,0,12,0" />
                                 
                     <ComboBox Grid.Column="2"
                               materialDesign:HintAssist.Hint="Status"
                               ItemsSource="{Binding Statuses}"
                               SelectedItem="{Binding SelectedStatus}"
                               Style="{StaticResource MaterialDesignOutlinedComboBox}"
                               Margin="0,0,12,0" />
                               
                     <ComboBox Grid.Column="3"
                               materialDesign:HintAssist.Hint="Priority"
                               ItemsSource="{Binding Priorities}"
                               SelectedItem="{Binding SelectedPriority}"
                               Style="{StaticResource MaterialDesignOutlinedComboBox}"
                               Margin="0,0,12,0" />
                               
                     <Button Grid.Column="4" Content="Reset"
                             Style="{StaticResource MaterialDesignOutlinedButton}"
                             Command="{Binding ResetFiltersCommand}"
                             Height="40" VerticalAlignment="Center" />
                 </Grid>
             </StackPanel>
         </Border>
 
         <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
             <UniformGrid Rows="1" Columns="3">
     
                 <!-- Customer Report -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6"
                         Margin="0,0,12,0" Padding="24">
                     <StackPanel>
                         <materialDesign:PackIcon Kind="AccountGroup" Width="36" Height="36" Foreground="#5C6BC0" Margin="0,0,0,12" />
                         <TextBlock Text="Customer Report" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                         <TextBlock Text="All customers with contact details" Opacity="0.55" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap" />
                         <StackPanel Orientation="Horizontal">
                             <Button Content="Excel" Style="{StaticResource MaterialDesignOutlinedButton}"
                                     Command="{Binding ExportCustomersExcelCommand}" Margin="0,0,8,0" />
                             <Button Content="PDF"   Style="{StaticResource MaterialDesignFlatButton}"
                                     Command="{Binding ExportCustomersPdfCommand}" />
                         </StackPanel>
                     </StackPanel>
                 </Border>
     
                 <!-- Product Report -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6"
                         Margin="0,0,12,0" Padding="24">
                     <StackPanel>
                         <materialDesign:PackIcon Kind="Devices" Width="36" Height="36" Foreground="#26A69A" Margin="0,0,0,12" />
                         <TextBlock Text="Product Report" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                         <TextBlock Text="Full products inventory list" Opacity="0.55" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap" />
                         <StackPanel Orientation="Horizontal">
                             <Button Content="Excel" Style="{StaticResource MaterialDesignOutlinedButton}"
                                     Command="{Binding ExportAssetsExcelCommand}" Margin="0,0,8,0" />
                             <Button Content="PDF"   Style="{StaticResource MaterialDesignFlatButton}"
                                     Command="{Binding ExportAssetsPdfCommand}" />
                         </StackPanel>
                     </StackPanel>
                 </Border>
     
                 <!-- Service Entry Report -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6"
                         Padding="24">
                     <StackPanel>
                         <materialDesign:PackIcon Kind="TicketOutline" Width="36" Height="36" Foreground="#EF5350" Margin="0,0,0,12" />
                         <TextBlock Text="Service Entry Report" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                         <TextBlock Text="All service entries with status and solution details" Opacity="0.55" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap" />
                         <StackPanel Orientation="Horizontal">
                             <Button Content="Excel" Style="{StaticResource MaterialDesignOutlinedButton}"
                                     Command="{Binding ExportTicketsExcelCommand}" Margin="0,0,8,0" />
                             <Button Content="PDF"   Style="{StaticResource MaterialDesignFlatButton}"
                                     Command="{Binding ExportTicketsPdfCommand}" />
                         </StackPanel>
                     </StackPanel>
                 </Border>
     
             </UniformGrid>
         </ScrollViewer>
     </Grid>
 </UserControl>
