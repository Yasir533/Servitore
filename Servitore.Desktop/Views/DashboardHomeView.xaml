<UserControl x:Class="Servitore.Desktop.Views.DashboardHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
 
     <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="24">
 
             <!-- Page header -->
             <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
             <TextBlock Text="Business overview at a glance" Opacity="0.55" FontSize="13" Margin="0,0,0,24" />
 
             <!-- Loading indicator -->
             <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                          IsIndeterminate="True"
                          Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,0,0,16" />
 
             <!-- Redesigned Upgraded Dashboard Widgets -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Side: Schedule Date & Time Widget -->
                <Border Margin="0,0,12,0" CornerRadius="8" Padding="24" Height="280">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E2A3A" Offset="0" />
                            <GradientStop Color="#0D1520" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Watermark background image of mechanical gears and headset -->
                        <Image Source="pack://application:,,,/Assets/Images/dashboard_background.png" 
                               Opacity="0.12" 
                               Stretch="Uniform" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Bottom" 
                               Width="160" Height="160" />

                        <DockPanel>
                            <TextBlock Text="Schedule Date &amp; Time" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="72" Height="72" Foreground="#3F51B5" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding Summary.QuickViewDeadlineCalls, FallbackValue='2'}" FontSize="84" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Right Side: Quick View Particulars Panel -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="20" Grid.Column="1" Margin="12,0,0,0">
                    <DockPanel>
                        <TextBlock Text="Quick View" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Particulars" DockPanel.Dock="Top" FontSize="12" Opacity="0.5" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="220">
                            <UniformGrid Columns="2" VerticalAlignment="Top">
                                <!-- Particular items -->
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,12,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Service Calls" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#E8EAF6" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewServiceCalls, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#3F51B5" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,4,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Pending Calls" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#FFE0B2" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewPendingCalls, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#FB8C00" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,12,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Dead Line Calls" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#FFCDD2" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewDeadlineCalls, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#E53935" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,4,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Priority Calls" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#F8BBD0" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewPriorityCalls, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#D81B60" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,12,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Calls Registered/Closed Today" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#E0F2F1" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewRegisteredClosedToday, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#00897B" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,4,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Pending for Customer Response" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#ECEFF1" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewPendingCustomerResponse, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#546E7A" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,12,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Pending for Spare" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#D7CCC8" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewPendingSpare, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#6D4C41" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,4,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Pending for Technical Support" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#E1BEE7" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewPendingTechnicalSupport, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#8E24AA" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,12,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Pending for Others Reason" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#F5F5F5" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewPendingOthers, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#616161" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,4,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Item not Delivered" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#FFECB3" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewItemNotDelivered, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#FFB300" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,12,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Unassigned Calls" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#CFD8DC" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewUnassignedCalls, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#37474F" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,4,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Transfer Requested" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#E0F7FA" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewTransferRequested, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#00838F" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="4,4,12,4" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Delivery Challan" VerticalAlignment="Center" FontSize="13" />
                                        <Border Background="#DCEDC8" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Summary.QuickViewDeliveryChallan, FallbackValue='0'}" FontSize="11.5" FontWeight="Bold" Foreground="#558B2F" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
 
             <!-- Row of Quick Actions -->
             <StackPanel Margin="0,0,0,24">
                 <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                 <UniformGrid Rows="1" Columns="4">
                     <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                             Command="{Binding AddCustomerCommand}" Margin="0,0,8,0" Height="48">
                         <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                             <TextBlock Text="Add Customer" VerticalAlignment="Center" />
                         </StackPanel>
                     </Button>
                     <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                             Command="{Binding AddProductCommand}" Margin="0,0,8,0" Height="48">
                         <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="Laptop" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                             <TextBlock Text="Add Product" VerticalAlignment="Center" />
                         </StackPanel>
                     </Button>
                     <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                             Command="{Binding CreateServiceEntryCommand}" Margin="0,0,8,0" Height="48">
                         <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                             <TextBlock Text="New Service Entry" VerticalAlignment="Center" />
                         </StackPanel>
                     </Button>
                     <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                             Command="{Binding ViewActivityLogsCommand}" Height="48">
                         <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                             <TextBlock Text="View Activity Logs" VerticalAlignment="Center" />
                         </StackPanel>
                     </Button>
                 </UniformGrid>
             </StackPanel>
 
             <!-- Main split columns: Recent Service Entries (left) vs Live Activity Feed (right) -->
             <Grid Margin="0,0,0,10">
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="3*" />
                     <ColumnDefinition Width="24" />
                     <ColumnDefinition Width="2*" />
                 </Grid.ColumnDefinitions>
 
                 <!-- Recent Service Entries -->
                 <StackPanel Grid.Column="0">
                     <TextBlock Text="Recent Service Entries" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                     <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Height="300">
                         <DataGrid ItemsSource="{Binding Summary.RecentServiceEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                                   FontSize="14" RowHeight="44"
                                   materialDesign:DataGridAssist.CellPadding="16 10 16 10"
                                   materialDesign:DataGridAssist.ColumnHeaderPadding="16 10 16 10">
                             <DataGrid.Columns>
                                 <DataGridTextColumn Header="Entry #" Binding="{Binding ServiceEntryNumber}" Width="110" />
                                 <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                                 <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="150" />
                                 <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90" />
                                 <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                             </DataGrid.Columns>
                         </DataGrid>
                     </Border>
                 </StackPanel>
 
                 <!-- Live Activity Feed -->
                 <StackPanel Grid.Column="2">
                     <TextBlock Text="Live Activity Feed" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                     <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="4" Height="300">
                         <Grid>
                             <!-- Empty state when no activities -->
                             <TextBlock Text="No recent activities."
                                        Opacity="0.45" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoActivities, Converter={StaticResource BooleanToVisibilityConverter}}" />
 
                             <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasNoActivities, Converter={StaticResource InverseBooleanConverter}}">
                                 <ItemsControl ItemsSource="{Binding Summary.RecentActivities}">
                                     <ItemsControl.ItemTemplate>
                                         <DataTemplate>
                                             <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                     BorderThickness="0,0,0,1" Padding="12,10">
                                                 <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
 
                                                     <materialDesign:PackIcon Kind="FlashOutline" Foreground="#FFB300" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
 
                                                     <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                         <TextBlock FontSize="13.5" TextWrapping="Wrap">
                                                             <Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" />
                                                             <Run Text=" " />
                                                             <Run Text="{Binding Action, Mode=OneWay}" />
                                                         </TextBlock>
                                                         <TextBlock Text="{Binding Module}" FontSize="11" Opacity="0.55" Margin="0,2,0,0" />
                                                     </StackPanel>
 
                                                     <TextBlock Grid.Column="2" Text="{Binding DateTime, StringFormat='{}{0:HH:mm:ss}'}"
                                                                Opacity="0.5" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                 </Grid>
                                             </Border>
                                         </DataTemplate>
                                     </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                             </ScrollViewer>
                         </Grid>
                     </Border>
                 </StackPanel>
             </Grid>
 
         </StackPanel>
     </ScrollViewer>
 </UserControl>
