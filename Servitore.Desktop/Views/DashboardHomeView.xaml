<UserControl x:Class="Servitore.Desktop.Views.DashboardHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
 
     <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel Margin="24">
 
             <!-- Page header -->
             <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4" />
             <TextBlock Text="Business overview at a glance" Opacity="0.55" FontSize="13" Margin="0,0,0,24" />
 
             <!-- Loading indicator -->
             <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                          IsIndeterminate="True"
                          Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,0,0,16" />
 
            <!-- 4 Top Cards (Row 1) -->
             <UniformGrid Rows="1" Columns="4" Margin="0,0,0,24">
                 <!-- Total Customers -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
                         </Grid.ColumnDefinitions>
                         <StackPanel Grid.Column="0">
                             <TextBlock Text="Customers" FontSize="13" Opacity="0.55" FontWeight="SemiBold" />
                             <TextBlock Text="{Binding Summary.TotalCustomers, FallbackValue='0'}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                         </StackPanel>
                         <materialDesign:PackIcon Grid.Column="1" Kind="AccountGroup" Width="36" Height="36" Foreground="#5C6BC0" VerticalAlignment="Center" />
                     </Grid>
                 </Border>

                 <!-- Total Products -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
                         </Grid.ColumnDefinitions>
                         <StackPanel Grid.Column="0">
                             <TextBlock Text="Assets / Products" FontSize="13" Opacity="0.55" FontWeight="SemiBold" />
                             <TextBlock Text="{Binding Summary.TotalProducts, FallbackValue='0'}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                         </StackPanel>
                         <materialDesign:PackIcon Grid.Column="1" Kind="Laptop" Width="36" Height="36" Foreground="#26A69A" VerticalAlignment="Center" />
                     </Grid>
                 </Border>

                 <!-- Open Service Entries -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
                         </Grid.ColumnDefinitions>
                         <StackPanel Grid.Column="0">
                             <TextBlock Text="Active Workload" FontSize="13" Opacity="0.55" FontWeight="SemiBold" />
                             <TextBlock Text="{Binding Summary.OpenServiceEntries, FallbackValue='0'}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                         </StackPanel>
                         <materialDesign:PackIcon Grid.Column="1" Kind="TicketOutline" Width="36" Height="36" Foreground="#EF5350" VerticalAlignment="Center" />
                     </Grid>
                 </Border>

                 <!-- Resolved Today -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
                         </Grid.ColumnDefinitions>
                         <StackPanel Grid.Column="0">
                             <TextBlock Text="Resolved Today" FontSize="13" Opacity="0.55" FontWeight="SemiBold" />
                             <TextBlock Text="{Binding Summary.ServiceEntriesResolvedToday, FallbackValue='0'}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                         </StackPanel>
                         <materialDesign:PackIcon Grid.Column="1" Kind="CheckCircleOutline" Width="36" Height="36" Foreground="#4CAF50" VerticalAlignment="Center" />
                     </Grid>
                 </Border>
             </UniformGrid>

             <!-- Charts & Quick View (Row 2) -->
             <Grid Margin="0,0,0,24">
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="1.6*" />
                     <ColumnDefinition Width="1.1*" />
                 </Grid.ColumnDefinitions>

                 <!-- Left Side: Performance & Trends -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                     <DockPanel>
                         <TextBlock Text="Performance &amp; Trends" DockPanel.Dock="Top" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
                         
                         <Grid>
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="24" />
                                 <RowDefinition Height="Auto" />
                             </Grid.RowDefinitions>

                             <!-- Monthly Resolved Bar Chart -->
                             <StackPanel Grid.Row="0">
                                 <TextBlock Text="Resolved Tickets Trend (Last 6 Months)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,12" />
                                 <ItemsControl ItemsSource="{Binding Summary.MonthlyResolveRates}">
                                     <ItemsControl.ItemsPanel>
                                         <ItemsPanelTemplate>
                                             <UniformGrid Rows="1" Columns="6" />
                                         </ItemsPanelTemplate>
                                     </ItemsControl.ItemsPanel>
                                     <ItemsControl.ItemTemplate>
                                         <DataTemplate>
                                             <Grid VerticalAlignment="Bottom" Height="140">
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="*" />
                                                     <RowDefinition Height="Auto" />
                                                     <RowDefinition Height="Auto" />
                                                 </Grid.RowDefinitions>
                                                 <TextBlock Grid.Row="0" Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" 
                                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                                 <Border Grid.Row="1" Background="#EF5350" Width="16" CornerRadius="3,3,0,0"
                                                         Height="{Binding BarHeight}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                 <TextBlock Grid.Row="2" Text="{Binding MonthName}" FontSize="9.5" Opacity="0.55" 
                                                            HorizontalAlignment="Center" Margin="0,4,0,0" />
                                             </Grid>
                                         </DataTemplate>
                                     </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                             </StackPanel>

                             <!-- Category Breakdown segmented bar -->
                             <StackPanel Grid.Row="2">
                                 <TextBlock Text="Ticket Categories Breakdown" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" />
                                 <Grid Height="12" Margin="0,0,0,12">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="{Binding WarrantyColumnWidth}" />
                                         <ColumnDefinition Width="{Binding OowColumnWidth}" />
                                         <ColumnDefinition Width="{Binding AmcColumnWidth}" />
                                     </Grid.ColumnDefinitions>
                                     <Border Grid.Column="0" Background="#4CAF50" CornerRadius="3,0,0,3" ToolTip="Warranty" />
                                     <Border Grid.Column="1" Background="#2196F3" ToolTip="Out of Warranty" />
                                     <Border Grid.Column="2" Background="#FF9800" CornerRadius="0,3,3,0" ToolTip="AMC" />
                                 </Grid>
                                 
                                 <UniformGrid Rows="1" Columns="3">
                                     <StackPanel>
                                         <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                             <Ellipse Width="6" Height="6" Fill="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center" />
                                             <TextBlock Text="Warranty" FontSize="11.5" FontWeight="SemiBold" />
                                         </StackPanel>
                                         <TextBlock FontSize="11" Opacity="0.7">
                                             <Run Text="{Binding WarrantyCount}" FontWeight="Bold" />
                                             <Run Text=" (" />
                                             <Run Text="{Binding WarrantyPercentage}" />
                                             <Run Text="%)" />
                                         </TextBlock>
                                     </StackPanel>
                                     <StackPanel>
                                         <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                             <Ellipse Width="6" Height="6" Fill="#2196F3" Margin="0,0,6,0" VerticalAlignment="Center" />
                                             <TextBlock Text="OOW" FontSize="11.5" FontWeight="SemiBold" />
                                         </StackPanel>
                                         <TextBlock FontSize="11" Opacity="0.7">
                                             <Run Text="{Binding OowCount}" FontWeight="Bold" />
                                             <Run Text=" (" />
                                             <Run Text="{Binding OowPercentage}" />
                                             <Run Text="%)" />
                                         </TextBlock>
                                     </StackPanel>
                                     <StackPanel>
                                         <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                             <Ellipse Width="6" Height="6" Fill="#FF9800" Margin="0,0,6,0" VerticalAlignment="Center" />
                                             <TextBlock Text="AMC" FontSize="11.5" FontWeight="SemiBold" />
                                         </StackPanel>
                                         <TextBlock FontSize="11" Opacity="0.7">
                                             <Run Text="{Binding AmcCount}" FontWeight="Bold" />
                                             <Run Text=" (" />
                                             <Run Text="{Binding AmcPercentage}" />
                                             <Run Text="%)" />
                                         </TextBlock>
                                     </StackPanel>
                                 </UniformGrid>
                             </StackPanel>
                         </Grid>
                     </DockPanel>
                 </Border>

                 <!-- Right Side: Status Details (Decluttered) -->
                 <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="20" Grid.Column="1" Margin="12,0,0,0">
                     <DockPanel>
                         <TextBlock Text="Status Breakdown" DockPanel.Dock="Top" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                         <ScrollViewer VerticalScrollBarVisibility="Auto" Height="290">
                             <StackPanel>
                                 <!-- Service Calls -->
                                 <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                     <Grid>
                                         <TextBlock Text="Total Calls" FontSize="13" VerticalAlignment="Center" />
                                         <TextBlock Text="{Binding Summary.QuickViewServiceCalls, FallbackValue='0'}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                     </Grid>
                                 </Border>
                                 <!-- Pending Calls -->
                                 <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                     <Grid>
                                         <TextBlock Text="Pending Calls" FontSize="13" VerticalAlignment="Center" />
                                         <TextBlock Text="{Binding Summary.QuickViewPendingCalls, FallbackValue='0'}" FontSize="13" FontWeight="Bold" Foreground="#FB8C00" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                     </Grid>
                                 </Border>
                                 <!-- Urgent/High Calls -->
                                 <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                     <Grid>
                                         <TextBlock Text="Urgent / Priority Calls" FontSize="13" VerticalAlignment="Center" />
                                         <TextBlock Text="{Binding Summary.QuickViewPriorityCalls, FallbackValue='0'}" FontSize="13" FontWeight="Bold" Foreground="#D81B60" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                     </Grid>
                                 </Border>
                                 <!-- Pending for Spare -->
                                 <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                     <Grid>
                                         <TextBlock Text="Pending for Spare Parts" FontSize="13" VerticalAlignment="Center" />
                                         <TextBlock Text="{Binding Summary.QuickViewPendingSpare, FallbackValue='0'}" FontSize="13" FontWeight="Bold" Foreground="#6D4C41" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                     </Grid>
                                 </Border>
                                 <!-- Pending Customer Response -->
                                 <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                     <Grid>
                                         <TextBlock Text="Pending Cust. Response" FontSize="13" VerticalAlignment="Center" />
                                         <TextBlock Text="{Binding Summary.QuickViewPendingCustomerResponse, FallbackValue='0'}" FontSize="13" FontWeight="Bold" Foreground="#546E7A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                     </Grid>
                                 </Border>
                                 <!-- Pending Technical Support -->
                                 <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                     <Grid>
                                         <TextBlock Text="Pending Tech. Support" FontSize="13" VerticalAlignment="Center" />
                                         <TextBlock Text="{Binding Summary.QuickViewPendingTechnicalSupport, FallbackValue='0'}" FontSize="13" FontWeight="Bold" Foreground="#8E24AA" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                     </Grid>
                                 </Border>
                                 <!-- Unassigned Calls -->
                                 <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                     <Grid>
                                         <TextBlock Text="Unassigned Calls" FontSize="13" VerticalAlignment="Center" />
                                         <TextBlock Text="{Binding Summary.QuickViewUnassignedCalls, FallbackValue='0'}" FontSize="13" FontWeight="Bold" Foreground="#37474F" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                     </Grid>
                                 </Border>
                             </StackPanel>
                         </ScrollViewer>
                     </DockPanel>
                 </Border>
             </Grid>
 
             <!-- Row of Quick Actions -->
             <StackPanel Margin="0,0,0,24">
                 <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                 <UniformGrid Rows="1" Columns="4">
                     <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                             Command="{Binding AddCustomerCommand}" Margin="0,0,8,0" Height="48">
                         <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                             <TextBlock Text="Add Customer" VerticalAlignment="Center" />
                         </StackPanel>
                     </Button>
                     <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                             Command="{Binding AddProductCommand}" Margin="0,0,8,0" Height="48">
                         <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="Laptop" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                             <TextBlock Text="Add Product" VerticalAlignment="Center" />
                         </StackPanel>
                     </Button>
                     <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                             Command="{Binding CreateServiceEntryCommand}" Margin="0,0,8,0" Height="48">
                         <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                             <TextBlock Text="New Service Entry" VerticalAlignment="Center" />
                         </StackPanel>
                     </Button>
                     <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                             Command="{Binding ViewActivityLogsCommand}" Height="48">
                         <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                             <TextBlock Text="View Activity Logs" VerticalAlignment="Center" />
                         </StackPanel>
                     </Button>
                 </UniformGrid>
             </StackPanel>
 
             <!-- Main split columns: Recent Service Entries (left) vs Live Activity Feed (right) -->
             <Grid Margin="0,0,0,10">
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="3*" />
                     <ColumnDefinition Width="24" />
                     <ColumnDefinition Width="2*" />
                 </Grid.ColumnDefinitions>
 
                 <!-- Recent Service Entries -->
                 <StackPanel Grid.Column="0">
                     <TextBlock Text="Recent Service Entries" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                     <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Height="300">
                         <DataGrid ItemsSource="{Binding Summary.RecentServiceEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                                   FontSize="14" RowHeight="44"
                                   materialDesign:DataGridAssist.CellPadding="16 10 16 10"
                                   materialDesign:DataGridAssist.ColumnHeaderPadding="16 10 16 10">
                             <DataGrid.Columns>
                                 <DataGridTextColumn Header="Entry #" Binding="{Binding ServiceEntryNumber}" Width="110" />
                                 <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                                 <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="150" />
                                 <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90" />
                                 <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                             </DataGrid.Columns>
                         </DataGrid>
                     </Border>
                 </StackPanel>
 
                 <!-- Live Activity Feed -->
                 <StackPanel Grid.Column="2">
                     <TextBlock Text="Live Activity Feed" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                     <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="4" Height="300">
                         <Grid>
                             <!-- Empty state when no activities -->
                             <TextBlock Text="No recent activities."
                                        Opacity="0.45" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoActivities, Converter={StaticResource BooleanToVisibilityConverter}}" />
 
                             <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasNoActivities, Converter={StaticResource InverseBooleanConverter}}">
                                 <ItemsControl ItemsSource="{Binding Summary.RecentActivities}">
                                     <ItemsControl.ItemTemplate>
                                         <DataTemplate>
                                             <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                     BorderThickness="0,0,0,1" Padding="12,10">
                                                 <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
 
                                                     <materialDesign:PackIcon Kind="FlashOutline" Foreground="#FFB300" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
 
                                                     <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                         <TextBlock FontSize="13.5" TextWrapping="Wrap">
                                                             <Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" />
                                                             <Run Text=" " />
                                                             <Run Text="{Binding Action, Mode=OneWay}" />
                                                         </TextBlock>
                                                         <TextBlock Text="{Binding Module}" FontSize="11" Opacity="0.55" Margin="0,2,0,0" />
                                                     </StackPanel>
 
                                                     <TextBlock Grid.Column="2" Text="{Binding DateTime, StringFormat='{}{0:HH:mm:ss}'}"
                                                                Opacity="0.5" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                 </Grid>
                                             </Border>
                                         </DataTemplate>
                                     </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                             </ScrollViewer>
                         </Grid>
                     </Border>
                 </StackPanel>
             </Grid>
 
         </StackPanel>
     </ScrollViewer>
 </UserControl>
