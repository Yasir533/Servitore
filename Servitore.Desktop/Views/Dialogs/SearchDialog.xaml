<Window x:Class="Servitore.Desktop.Views.Dialogs.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Search" Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        FontSize="14">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="SearchTextBox"
                     materialDesign:HintAssist.Hint="Search Text"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     VerticalAlignment="Center" />

            <ComboBox Grid.Column="2" x:Name="SearchByCombo"
                      materialDesign:HintAssist.Hint="Search by"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="SCR No." IsSelected="True" />
                <ComboBoxItem Content="Customer Name" />
                <ComboBoxItem Content="Serial No." />
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Search" IsDefault="True" Click="Search_Click" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0" Width="90" />
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Width="90" />
        </StackPanel>
    </Grid>
</Window>
