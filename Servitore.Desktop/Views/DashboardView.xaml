<UserControl x:Class="Servitore.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Servitore.Desktop">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             Dark Sidebar Navigation
        ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource ServitoreSidebarBrush}">
            <DockPanel>

                <!-- Brand header -->
                <Border DockPanel.Dock="Top"
                        Padding="16,20"
                        BorderBrush="#2C3E50"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Assets/Images/logo.png"
                               Height="36" Width="36"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Stretch="Uniform" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SERVITORE"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock Text="Service Management"
                                       FontSize="9"
                                       Opacity="0.45"
                                       Foreground="White"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">

                    <Button Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="Customers">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Customers" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="Products">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Devices" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Products" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="ServiceEntries">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TicketOutline" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Service Entries" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>



                    <!-- Separator -->
                    <Separator Background="#2C3E50" Margin="20,8" />

                    <Button Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="Reports">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Reports" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="UsersBtn" Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="Users">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCog" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Users" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ActivityLogsBtn" Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="ActivityLogs">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewList" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Activity Logs" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="LiveUsersBtn" Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="LiveUsers">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountMultiple" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Live Users" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsBtn" Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RecentlyDeletedBtn" Style="{StaticResource SidebarNavButton}"
                            Click="NavButton_Click" Tag="RecentlyDeleted">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweep" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Recently Deleted" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Main Menu Bar -->
            <Menu Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" FontSize="13.5" Padding="8,4">
                <MenuItem Header="Masters">
                    <MenuItem Header="Customer Type">
                        <MenuItem Header="Add" Click="Menu_CustomerTypeAdd_Click" />
                        <MenuItem Header="Display" Click="Menu_CustomerTypeDisplay_Click" />
                    </MenuItem>
                    <MenuItem Header="Customer" Click="Menu_Customer_Click" />
                    <MenuItem Header="Authorised Service Provider" Click="Menu_ASP_Click" />
                    <MenuItem Header="Tax Master" Click="Menu_TaxMaster_Click" />
                    <MenuItem Header="Service Category">
                        <MenuItem Header="Add" Click="Menu_ServiceCategoryAdd_Click" />
                        <MenuItem Header="Display" Click="Menu_ServiceCategoryDisplay_Click" />
                    </MenuItem>
                    <MenuItem Header="Item Category" Click="Menu_ItemCategory_Click" />
                    <MenuItem Header="Manufacturer" Click="Menu_Manufacturer_Click" />
                    <MenuItem Header="Item" Click="Menu_Item_Click" />
                    <MenuItem Header="Area Master" Click="Menu_AreaMaster_Click" />
                    <MenuItem Header="Service Center" Click="Menu_ServiceCenter_Click" />
                </MenuItem>
                <MenuItem Header="Maintenance Contract">
                    <MenuItem Header="New Contract" Click="Menu_NewContract_Click" />
                    <MenuItem Header="Display Contracts" Click="Menu_DisplayContracts_Click" />
                    <MenuItem Header="PM Calls Pending to be Registered" Click="Menu_PMCallsPending_Click" />
                </MenuItem>
                <MenuItem Header="Warranty">
                    <MenuItem Header="Add Warranty Info" Click="Menu_AddWarrantyInfo_Click" />
                    <MenuItem Header="View Warranty Info" Click="Menu_ViewWarrantyInfo_Click" />
                </MenuItem>
                <MenuItem Header="Service">
                    <MenuItem Header="Service Call Register (F3)" InputGestureText="F3" Click="Menu_ServiceCallRegister_Click" />
                    <MenuItem Header="Pending Calls (Ctrl+P)" InputGestureText="Ctrl+P" Click="Menu_PendingCalls_Click" />
                    <MenuItem Header="Transfer Requested Calls" Click="Menu_TransferRequestedCalls_Click" />
                </MenuItem>
                <MenuItem Header="Delivery Challan">
                    <MenuItem Header="Add Delivery Challan" Click="Menu_AddDeliveryChallan_Click" />
                    <MenuItem Header="View Delivery Challans" Click="Menu_ViewDeliveryChallans_Click" />
                </MenuItem>
                <MenuItem Header="Reports">
                    <MenuItem Header="Service Bills">
                        <MenuItem Header="Bill Ledger" Click="Menu_BillLedger_Click" />
                    </MenuItem>
                    <MenuItem Header="Display Service Calls (F6)" InputGestureText="F6" Click="Menu_DisplayServiceCalls_Click" />
                    <MenuItem Header="ASP Reports">
                        <MenuItem Header="Company Wise Reports" Click="Menu_CompanyWiseReports_Click" />
                    </MenuItem>
                    <MenuItem Header="Area Related Reports">
                        <MenuItem Header="Area Wise" Click="Menu_AreaWise_Click" />
                        <MenuItem Header="Area Wise Customer Wise" Click="Menu_AreaWiseCustomerWise_Click" />
                        <MenuItem Header="Area Wise Engineer Wise" Click="Menu_AreaWiseEngineerWise_Click" />
                        <MenuItem Header="Area Wise Calls Closed Bills Not Raised" Click="Menu_AreaWiseClosedBillsNotRaised_Click" />
                        <MenuItem Header="Area Wise Payment Pending Report" Click="Menu_AreaWisePaymentPending_Click" />
                        <MenuItem Header="Area Wise Items Not Delivered Report" Click="Menu_AreaWiseItemsNotDelivered_Click" />
                    </MenuItem>
                    <MenuItem Header="Engineer Wise">
                        <MenuItem Header="Revenue / Expenditure" Click="Menu_EngineerRevenueExpenditure_Click" />
                        <MenuItem Header="Pending Calls (F8)" InputGestureText="F8" Click="Menu_EngineerPendingCalls_Click" />
                    </MenuItem>
                    <MenuItem Header="Maintenance Contract Reports" Click="Menu_MaintenanceContractReports_Click" />
                    <MenuItem Header="Warranty Reports">
                        <MenuItem Header="Warranty Wise Expenditure Reports" Click="Menu_WarrantyExpenditure_Click" />
                        <MenuItem Header="Near Expiry Warranty Report" Click="Menu_WarrantyNearExpiry_Click" />
                    </MenuItem>
                    <MenuItem Header="StandBy Reports" Click="Menu_StandByReports_Click" />
                </MenuItem>
                <MenuItem Header="Administration" Click="Menu_Administration_Click" />
                <MenuItem Header="Settings" Click="Menu_Settings_Click" />
                <MenuItem Header="Window" Click="Menu_Window_Click" />
                <MenuItem Header="Logout" Click="Menu_Logout_Click" />
            </Menu>

            <!-- Top Header Bar -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Global Search (styled input with autocomplete) -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBox materialDesign:HintAssist.Hint="Global search..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 x:Name="GlobalSearchBox"
                                 TextChanged="GlobalSearchBox_TextChanged"
                                 KeyDown="GlobalSearchBox_KeyDown" />
                        <Popup x:Name="SearchAutocompletePopup"
                               StaysOpen="False"
                               PlacementTarget="{Binding ElementName=GlobalSearchBox}"
                               Placement="Bottom"
                               Width="300"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MaxHeight="350"
                                    Padding="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SearchResultsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                        HorizontalContentAlignment="Left"
                                                        Click="SearchResult_Click"
                                                        Margin="0,2"
                                                        Padding="8,4">
                                                    <Grid HorizontalAlignment="Stretch" Width="260">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13.5" />
                                                            <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="11.5" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Opacity="0.5" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- User Profile & Notifications -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- Refresh Button -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                x:Name="RefreshBtn"
                                Click="RefreshBtn_Click"
                                ToolTip="Refresh Page Data"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                        </Button>

                        <!-- Notification Button -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                x:Name="NotificationBtn"
                                Click="NotificationBtn_Click"
                                ToolTip="Notification Center"
                                Margin="0,0,16,0">
                            <Grid>
                                <materialDesign:PackIcon Kind="Bell" Width="20" Height="20" />
                                <!-- Badge indicator (red dot) -->
                                <Border Background="Red" CornerRadius="4" Width="8" Height="8" 
                                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Margin="0,-2,-2,0" 
                                        Visibility="{Binding HasNoNotifications, Converter={StaticResource InverseBooleanConverter}}" />
                            </Grid>
                        </Button>

                        <!-- Notification Popup -->
                        <Popup x:Name="NotificationPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=NotificationBtn}" Placement="Bottom">
                            <Border Background="{DynamicResource MaterialDesignPaper}" 
                                    BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                    BorderThickness="1" CornerRadius="4" Width="320" MaxHeight="400" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Notification Center" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />
                                    <Separator Margin="0,0,0,12" />
                                    
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                        <ItemsControl ItemsSource="{Binding Summary.RecentNotifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13.5" />
                                                            <TextBlock Grid.Row="1" Text="{Binding CreatedDate, StringFormat='{}{0:dd MMM HH:mm}'}" 
                                                                       Opacity="0.5" FontSize="11" Margin="0,4,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    
                                    <TextBlock Text="No new notifications." Opacity="0.5" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0"
                                               Visibility="{Binding HasNoNotifications, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Logged-in User Info -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Source={x:Static local:App.AuthenticationService}, Path=CurrentUser.FullName, FallbackValue='John Doe'}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding Source={x:Static local:App.AuthenticationService}, Path=CurrentUser.Role, FallbackValue='Operator'}"
                                       Opacity="0.55" FontSize="10" HorizontalAlignment="Right" />
                        </StackPanel>
                        
                        <!-- Avatar Icon -->
                        <materialDesign:PackIcon Kind="AccountCircle" Width="32" Height="32" VerticalAlignment="Center" Opacity="0.75" />

                        <!-- Status Indicator (Automatic) -->
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="CurrentUserStatusLight" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#9E9E9E" />
                            <TextBlock x:Name="CurrentUserStatusText" Text="Offline" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area Host -->
            <ContentControl x:Name="ContentHost" Grid.Row="2" />

            <!-- Toast Notification Area -->
            <materialDesign:Snackbar x:Name="MainSnackbar" Grid.Row="2"
                                     MessageQueue="{materialDesign:MessageQueue}"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                     Margin="24,0,0,24" />
        </Grid>
    </Grid>
</UserControl>
