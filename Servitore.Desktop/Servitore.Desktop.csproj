 <Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Avoid generating apphost.exe which can be locked by a running process during rebuilds -->
    <UseAppHost>true</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Servitore.Desktop</RootNamespace>
    <ApplicationIcon>Assets\Icons\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\logo.ico" />
    <Resource Include="Assets\Images\logo.png" />
    <Resource Include="Assets\Images\dashboard_background.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="MaterialDesignColors" Version="3.1.0" /> 
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Servitore.Shared\Servitore.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ApiSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="KillRunningDesktop" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -Command &quot;Get-Process -Name Servitore.Desktop -ErrorAction SilentlyContinue | Stop-Process -Force&quot;" IgnoreExitCode="true" />
    <Exec Command="powershell -Command &quot;Get-CimInstance Win32_Process -Filter \&quot;Name = 'dotnet.exe' AND CommandLine LIKE '%Servitore.Desktop.dll%' AND CommandLine NOT LIKE '%MSBuild%' AND CommandLine NOT LIKE '%csc%' AND CommandLine NOT LIKE '%VBCSCompiler%'\&quot; -ErrorAction SilentlyContinue | Remove-CimInstance&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
